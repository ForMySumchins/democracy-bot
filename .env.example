# --- Discord (from Developer Portal > Applications > Bot) ---
DISCORD_TOKEN=
# Guild + channel IDs (owner-supplied; verify in your target server)
#   Guild 1535595201614184562 per spec (unverified — confirm it's the ops guild)
GUILD_ID=
# Channel that receives /dumbass receipts + logs (FS-02)
LOG_CHANNEL_ID=
# Optional: channel the bot listens for inline commands in (empty = any channel)
LISTEN_CHANNEL_ID=

# --- Jules CLI (auth is via gnome-keyring, not env) ---
# Path to the jules binary (npm global install under NixOS)
JULES_BIN=/home/sama/.local/bin/jules
# DBus session bus the keyring talks over (needed to read the stored token)
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# Default repo for /jules-new when the user omits one
DEFAULT_REPO=ForMySumchins/democracy-bot

# --- Safety ---
# If set, /jules-new and /jules-pull REFUSE to run unless GUILD_ID is in this comma list
ALLOWED_GUILDS=
